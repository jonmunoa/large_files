@{
    ViewData["Title"] = "Telegram Bot";
}

<div class="text-center">
    <div class="container">
        <div class="col">
            <div class="row">
                <div class="col">
                    <form method="post" asp-action="TodasOfertas" class="btn-group-sm">
                        <input type="submit" value="Crear todas las ofertas" class="btn btn-success" />
                    </form>
                    <p>@ViewData["OfertasCreadas"]</p>

                    <form method="post" asp-action="TodasOfertas2" class="btn-group-sm">
                        <input type="submit" value="Crear todas las ofertas 2" class="btn btn-success" />
                    </form>
                    <p>@ViewData["OfertasCreadas2"]</p>

