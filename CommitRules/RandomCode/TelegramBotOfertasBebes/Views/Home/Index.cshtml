                    </form>
                    <p>@ViewData["OfertaPanalesCreada"]</p>

                    <form method="post" asp-action="GeneralBebe" class="btn-group-sm">
                        <input type="submit" value="Crear oferta para bebe en general" class="btn btn-warning" />
                    </form>
                    <p>@ViewData["OfertaJuguetesCreada"]</p>
                    <form method="post" asp-action="RopaBebe" class="btn-group-sm">
